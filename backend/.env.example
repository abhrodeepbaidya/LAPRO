# Generate a secret locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Local development. Set Render's internal PostgreSQL URL in production.
DATABASE_URL=sqlite:///./lapro_dev.db

# Comma-separated allowed website origins. Add your deployed frontend origin.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://abhrodeepbaidya.github.io

# Set this to the email address that should receive the initial Owner role.
# Configure privately in Render, never commit the real email if you prefer not to.
OWNER_EMAIL=owner@example.com
