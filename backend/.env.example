# Required: generate a long random secret; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRE_MINUTES=60

# Local development default. On Render, use the Internal Database URL.
DATABASE_URL=sqlite:///./lapro_dev.db

# Comma-separated frontend origins. Add your GitHub Pages URL for production.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://abhrodeepbaidya.github.io
